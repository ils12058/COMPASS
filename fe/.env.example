# Server-only backend origin used by the Next.js development rewrite.
COMPASS_API_BASE_URL=http://127.0.0.1:8000

# Canonical origin used for social-sharing metadata and the CORS response header.
# The exact COMPASS staging origin enables
# no-index metadata and robots.txt; future public production origins remain indexable.
COMPASS_SITE_URL=http://localhost:3000

# Public Cloudflare Turnstile site key. Leave blank only when the backend does not require it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Realtime hints (ADR-100) connect whenever the API host's realtime socket URL is configured, e.g.
# wss://staging-api.compass-gco.com/api/realtime/v1/socket (ws:// only in development). The
# realtime service must allow this frontend's exact Origin. HTTP and polling remain authoritative.
NEXT_PUBLIC_REALTIME_URL=

# Server-only, build-time CSP allowlist for browser-facing object storage. List exact HTTPS
# origins, comma separated, for profile photos and signed resource/recording URLs. Include each
# virtual-hosted bucket origin when it differs from the S3 endpoint; never paste a signed URL,
# path, storage key, or credential here. Empty is safe while the CSP remains report-only.
# Example (synthetic): https://media.example.test,https://recordings.example.test
COMPASS_CSP_STORAGE_ORIGINS=
