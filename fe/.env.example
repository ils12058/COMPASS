# Server-only backend origin used by the Next.js development rewrite.
COMPASS_API_BASE_URL=http://127.0.0.1:8000

# Canonical origin used for social-sharing metadata. The exact COMPASS staging origin enables
# no-index metadata and robots.txt; future public production origins remain indexable.
COMPASS_SITE_URL=http://localhost:3000

# Public Cloudflare Turnstile site key. Leave blank only when the backend does not require it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
