{
  "name": "compass-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "api:generate": "orval --config orval.config.ts",
    "test": "node --import ./tests/support/register-tsx.mjs --test tests/*.test.mjs",
    "test:ui:assessment": "node tests/assessment-records.browser.mjs && COMPASS_UI_BROWSER=webkit node tests/assessment-records.browser.mjs",
    "test:ui": "node tests/run-browser-regressions.mjs",
    "test:ui:regressions": "node tests/run-browser-regressions.mjs",
    "validate": "pnpm api:generate && pnpm lint && pnpm typecheck && pnpm build",
    "test:ui:ux": "node tests/ux-hardening.browser.mjs && COMPASS_UI_BROWSER=webkit node tests/ux-hardening.browser.mjs",
    "test:ui:consistency": "node tests/frontend-consistency.browser.mjs && COMPASS_UI_BROWSER=webkit node tests/frontend-consistency.browser.mjs",
    "test:ui:copy": "node tests/user-copy.browser.mjs && COMPASS_UI_BROWSER=webkit node tests/user-copy.browser.mjs",
    "test:ui:ecounseling:safety": "node tests/ecounseling-safety-access.browser.mjs && COMPASS_UI_BROWSER=webkit node tests/ecounseling-safety-access.browser.mjs",
    "test:ui:ecounseling:consent": "node tests/ecounseling-consent-realtime.browser.mjs && COMPASS_UI_BROWSER=webkit node tests/ecounseling-consent-realtime.browser.mjs",
    "test:ui:ecounseling:media": "node tests/ecounseling-media-realtime.browser.mjs && COMPASS_UI_BROWSER=webkit node tests/ecounseling-media-realtime.browser.mjs",
    "test:ui:feedback": "node tests/customer-feedback-identity.browser.mjs && COMPASS_UI_BROWSER=webkit node tests/customer-feedback-identity.browser.mjs",
    "test:ui:forms": "node tests/form-input-standardization.browser.mjs && COMPASS_UI_BROWSER=webkit node tests/form-input-standardization.browser.mjs",
    "test:ui:counseling:encounter": "node tests/counseling-encounter-consistency.browser.mjs && COMPASS_UI_BROWSER=webkit node tests/counseling-encounter-consistency.browser.mjs",
    "test:ui:call-slips": "node tests/call-slip-permissions.browser.mjs && COMPASS_UI_BROWSER=webkit node tests/call-slip-permissions.browser.mjs",
    "test:ui:form-guidance": "node tests/form-ui-1b.browser.mjs && COMPASS_UI_BROWSER=webkit node tests/form-ui-1b.browser.mjs"
  },
  "dependencies": {
    "@daily-co/daily-js": "0.92.2",
    "@milkdown/kit": "7.22.2",
    "@milkdown/react": "7.22.2",
    "@radix-ui/react-alert-dialog": "1.1.23",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-tooltip": "1.3.0",
    "@tanstack/react-query": "5.103.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.41.0",
    "next": "16.3.4",
    "qrcode.react": "4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "20.19.43",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "orval": "8.29.0",
    "playwright": "1.62.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
