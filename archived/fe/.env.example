# Server-only backend origin used by Next.js rewrites.
# Do not expose this as NEXT_PUBLIC_*.
COMPASS_API_BASE_URL=http://127.0.0.1:8000

# Public Cloudflare Turnstile site key. Leave empty only when the backend environment disables
# Turnstile for the flow being tested.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
