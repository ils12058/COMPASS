FROM python:3.13-slim-bookworm

ARG COMPASS_BUILD_ID=local
ARG COMPASS_BUILD_TIME=""
ARG COMPASS_VERSION=""

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONFAULTHANDLER=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    COMPASS_BUILD_ID="${COMPASS_BUILD_ID}" \
    COMPASS_BUILD_TIME="${COMPASS_BUILD_TIME}"

LABEL org.opencontainers.image.title="COMPASS Backend" \
    org.opencontainers.image.description="Counseling Office Management Platform and Student Services backend" \
    org.opencontainers.image.source="https://github.com/ils12058/COMPASS" \
    org.opencontainers.image.revision="${COMPASS_BUILD_ID}" \
    org.opencontainers.image.version="${COMPASS_VERSION}" \
    org.opencontainers.image.created="${COMPASS_BUILD_TIME}"

COPY --from=ghcr.io/astral-sh/uv:0.11.2 /uv /uvx /bin/

WORKDIR /app

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
RUN mkdir -p /ms-playwright \
    && uv run playwright install --with-deps --only-shell chromium \
    && chmod -R a+rX /ms-playwright

COPY . .

RUN addgroup --system compass \
    && adduser --system --ingroup compass compass \
    && chown -R compass:compass /app

USER compass
ENV PATH="/app/.venv/bin:${PATH}" \
    DJANGO_SETTINGS_MODULE=config.settings

EXPOSE 8000

CMD ["gunicorn", "--bind", "0.0.0.0:8000", "--workers", "2", "--no-control-socket", "--access-logfile", "-", "--error-logfile", "-", "config.wsgi:application"]
