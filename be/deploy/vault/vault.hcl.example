# Dedicated host service. No dev mode, auto-unseal keys, or application release storage.
ui = false
disable_mlock = true
api_addr = "https://127.0.0.1:8200"
cluster_addr = "https://127.0.0.1:8201"
storage "raft" {
  path = "/var/lib/vault/raft"
  node_id = "compass-staging-1"
}
listener "tcp" {
  address = "127.0.0.1:8200"
  cluster_address = "127.0.0.1:8201"
  tls_cert_file = "/etc/vault.d/tls/server.crt"
  tls_key_file = "/etc/vault.d/tls/server.key"
  tls_min_version = "tls12"
}
