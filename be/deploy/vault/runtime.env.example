# Pointer overlay for /opt/compass/.env after operator cutover; no secret values.
# Preserve all ordinary deployment settings. Remove direct forms and legacy URL overrides.
APP_ENV=live-staging
RUNTIME_SECRETS_MODE=files
REDIS_HOST=redis
REDIS_PORT=6379
SECRET_KEY_FILE=/run/secrets/compass/django_secret_key
POSTGRES_PASSWORD_FILE=/run/secrets/compass/postgres_password
REDIS_PASSWORD_FILE=/run/secrets/compass/redis_password
S3_ACCESS_KEY_ID_FILE=/run/secrets/compass/s3_access_key_id
S3_SECRET_ACCESS_KEY_FILE=/run/secrets/compass/s3_secret_access_key
SMTP_USERNAME_FILE=/run/secrets/compass/smtp_username
SMTP_PASSWORD_FILE=/run/secrets/compass/smtp_password
TURNSTILE_SECRET_KEY_FILE=/run/secrets/compass/turnstile_secret_key
DAILY_API_KEY_FILE=/run/secrets/compass/daily_api_key
DAILY_WEBHOOK_HMAC_FILE=/run/secrets/compass/daily_webhook_hmac
PSGC_API_TOKEN_FILE=/run/secrets/compass/psgc_api_token
AUTH_TOTP_ENCRYPTION_KEY_FILE=/run/secrets/compass/auth_totp_encryption_key
ROUTINE_INTERVIEW_ENCRYPTION_KEYS_FILE=/run/secrets/compass/routine_interview_encryption_keys
WEB_PUSH_PRIVATE_KEY_FILE=/run/secrets/compass/web_push_private_key
WEB_PUSH_STORAGE_KEY_FILE=/run/secrets/compass/web_push_storage_key
