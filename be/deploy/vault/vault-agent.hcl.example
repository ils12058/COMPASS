# No listener, token sink, proxy, cache, or environment templates.
vault {
  address = "https://127.0.0.1:8200"
  ca_cert = "/etc/vault.d/tls/ca.crt"
}
auto_auth {
  method "approle" {
    mount_path = "auth/approle"
    config = {
      role_id_file_path = "/etc/vault-agent.d/credentials/role-id"
      secret_id_file_path = "/etc/vault-agent.d/credentials/secret-id"
      remove_secret_id_file_after_reading = false
    }
  }
}
template_config {
  exit_on_retry_failure = true
  static_secret_render_interval = "5m"
}

template {
  contents = "{{- with secret \"kv/data/compass/live-staging/core\" -}}{{ .Data.data.secret_key }}{{- end -}}"
  destination = "/run/compass-secrets/django_secret_key"
  perms = "0440"
  backup = false
  error_on_missing_key = true
}

