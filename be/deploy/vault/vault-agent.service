[Unit]
Description=COMPASS runtime secret renderer
After=vault.service
Requires=vault.service
PartOf=vault.service

[Service]
User=compass-vault-agent
Group=compass-secrets
ExecStart=/usr/bin/vault agent -config=/etc/vault-agent.d/agent.hcl
Restart=on-failure
RestartSec=10
UMask=0027
RuntimeDirectory=compass-secrets
RuntimeDirectoryMode=0710
RuntimeDirectoryPreserve=no
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/compass-secrets

[Install]
WantedBy=multi-user.target
